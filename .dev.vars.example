# ローカル開発用。実際の値は .dev.vars に置く（コミットしない）
GRANT_SECRET="ローカル開発用のランダムな文字列に置き換えてください"

# 任意設定。削除レシートの保持期間（日）。未設定なら 90 日
# RECEIPT_RETENTION_DAYS="90"

# 1 リンクの合計サイズ上限 (バイト)。未設定なら 5 GiB。例: 100 GiB
# MAX_FILE_SIZE="107374182400"

# リンクに設定できる有効期限の上限 (時間)。未設定なら 168 (7 日)。例: 30 日
# MAX_EXPIRY_HOURS="720"

# Cloudflare Turnstile のシークレット。未設定なら POST /api/uploads の検証をスキップする
# （サイトキーは秘密ではないので wrangler.jsonc の vars.TURNSTILE_SITE_KEY に書く）
# TURNSTILE_SECRET="ローカル開発用のテスト用シークレットに置き換えてください"

{
  "name": "cryptbox",
  "version": "0.1.0",
  "description": "端末内で暗号化する大容量ファイル転送 (Cloudflare Workers + R2 + D1)",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuma007708/CryptBox.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Yuma007708/CryptBox/issues"
  },
  "homepage": "https://github.com/Yuma007708/CryptBox#readme",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260901.1",
    "happy-dom": "^20.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.0.5",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.5"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "deploy": "npm run build:web && npm run db:init && wrangler deploy",
    "db:init": "wrangler d1 execute cryptbox --remote --file=src/schema.sql",
    "db:init:local": "wrangler d1 execute cryptbox --local --file=src/schema.sql",
    "db:migrate": "wrangler d1 execute cryptbox --remote --file=src/migrations/0001-security-audit.sql",
    "build:native": "VITE_TARGET=native vite build --config web/vite.config.ts",
    "cap:sync": "npm run build:native && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#ffffff\" --iconBackgroundColorDark \"#15151e\" --splashBackgroundColor \"#f5f5fa\" --splashBackgroundColorDark \"#0d0d13\""
  }
}

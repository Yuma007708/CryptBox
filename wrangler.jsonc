{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // /d/<token> のような擬似パスも index.html に落とす
    "not_found_handling": "single-page-application",
    // API を Worker 側で先に処理する
    "run_worker_first": ["/api/*"]
  },

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cryptbox-blobs",
      "preview_bucket_name": "cryptbox-blobs-dev"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cryptbox",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  "triggers": {
    // 自動削除: 毎分、期限切れ・回数上限到達のバンドルを R2 ごと消す
    // （正常系は finish 通知で即時削除。Cron は取りこぼしの回収）
    "crons": ["* * * * *"]
  },

  "vars": {
    // 1 リンクの合計サイズ上限 (バイト)。公開ホスト版の既定値は 5 GiB。
    // セルフホストで変える場合はここを書き換える（例: 100 GiB = "107374182400"）
    "MAX_FILE_SIZE": "5368709120",
    // リンクに設定できる有効期限の上限 (時間)。既定 168 (7 日)。
    // これを超える expiresIn / expiresAt はサーバーが 400 で拒否する
    "MAX_EXPIRY_HOURS": "168"
    // 削除レシートの保持期間（日）。未設定なら 90 日
    // "RECEIPT_RETENTION_DAYS": "90"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // /d/<token> のような擬似パスも index.html に落とす
    "not_found_handling": "single-page-application",
    // API を Worker 側で先に処理する
    "run_worker_first": ["/api/*"]
  },

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cryptbox-blobs",
      "preview_bucket_name": "cryptbox-blobs-dev"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cryptbox",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  "triggers": {
    // 自動削除: 毎分、期限切れ・回数上限到達のバンドルを R2 ごと消す
    // （正常系は finish 通知で即時削除。Cron は取りこぼしの回収）
    "crons": ["* * * * *"]
  },

  "vars": {
    // 1 リンクの合計サイズ上限 (バイト)。公開ホスト版の既定値は 5 GiB。
    // セルフホストで変える場合はここを書き換える（例: 100 GiB = "107374182400"）
    "MAX_FILE_SIZE": "5368709120",
    // リンクに設定できる有効期限の上限 (時間)。既定 168 (7 日)。
    // これを超える expiresIn / expiresAt はサーバーが 400 で拒否する
    "MAX_EXPIRY_HOURS": "168",
    // 広告枠（ダミー）の表示。"1" で有効。広告ネットワークは未接続で、レイアウトのみ
    "ADS_ENABLED": "0",
    // Turnstile のサイトキー（公開値）。空ならクライアントは Turnstile を読み込まない。
    // シークレットは `wrangler secret put TURNSTILE_SECRET` で別途設定する
    "TURNSTILE_SITE_KEY": "",
    // 運営者名・連絡先（公開値）。GET /api/config で返す。空ならヘルプの節を省略する
    "OPERATOR_NAME": "",
    "OPERATOR_CONTACT": ""
    // 削除レシートの保持期間（日）。未設定なら 90 日
    // "RECEIPT_RETENTION_DAYS": "90"
  },

  // POST /api/uploads を IP あたり 10 回/分 に絞る（Workers Rate Limiting）。
  // セルフホストで外したい場合はこのブロックごと削除する（binding が無ければ制限しない）
  "ratelimits": [
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    // POST /api/files/:token/report を IP あたり 5 回/分 に絞る
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
